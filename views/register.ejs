<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create account | Click-a-Streak</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="site-main">
    <section class="content">
      <h1>Create account</h1>
      <% if (error) { %><p role="alert"><%= error %></p><% } %>
      <form method="POST" action="/register">
        <label>Username <input name="username" value="<%= username %>" required autocomplete="username" /></label>
        <label>Email <input type="email" name="email" value="<%= email || '' %>" required autocomplete="email" /></label>
        <label>Password <input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
        <button class="up" type="submit">Create account</button>
      </form>
      <p>Already registered? <a href="/login">Log in</a>.</p>
    </section>
  </main>
</body>
</html>
