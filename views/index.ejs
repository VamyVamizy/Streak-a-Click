<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Build your clicking streak one tap at a time." />
  <title>Click-a-Streak</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="site-header">
    <nav aria-label="Main navigation">
      <a class="brand" href="/">Click-a-Streak 🔥</a>
      <% if (isAuthenticated) { %>
        <span>Signed in as <%= username %></span>
        <a href="/logout">Log out</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/register">Create account</a>
      <% } %>
    </nav>
  </header>

  <main class="site-main">
    <p>CPS: <span id="cps">0</span> / 25</p>
    <section class="hero" aria-labelledby="page-title">
      <div class="num">
        <span id="clicks" style="user-select: none">0</span>
        <span id="str" data-strength="<%= str %>" style="--color: linear-gradient(to right, gray, gray);">+0</span>
      </div>
      <button class="btn" id="mainBTN" tabindex="-1">Click</button>
      <div class="streakCont">
        <div class="bars">
            <% streak.forEach((lvl, index) => { %>
                <progress id="progress" class="streakBar <%= lvl %>" data-value="<%= lvl %>" max="<%= (lvl*100) %>" value="0" style="--gColor: linear-gradient(to right, orange, rgb(255, 123, 0))">0%</progress>
            <% }); %>
        </div>
        <div id="streakNum" style="--scale: 14px;">🔥1x</div>
      </div>
      <div class="btns_row">
        <div class="upgradeCont">
          <form>
            <button class="up" type="button" id="streakUp">+1 Streak</button>
          </form>
        </div>
        <div class="overclock">
          <button class="up" id="overclock">Overclock</button>
        </div>
      </div>
      <div class="stats">
        <div class="updata drainage">
          <button class="up" id="drainage">Drainage</button>
          <div class="lvl"></div>
          <div>|</div>
          <div class="cost"></div>
          <div>|</div>
          <div class="current"></div>
        </div>
        <div class="updata force">
          <button class="up" id="force">Force</button>
          <div class="lvl"></div>
          <div>|</div>
          <div class="cost"></div>
          <div>|</div>
          <div class="current"></div>
        </div>
        <div class="updata critical">
          <button class="up" id="critical">Critical Chance</button>
          <div class="lvl"></div>
          <div>|</div>
          <div class="cost"></div>
          <div>|</div>
          <div class="current"></div>
        </div>
      </div>
      <div class="time-freeze">
        <h3>Time Freeze</h3>
        <p>
          Duration:
          <span id="timeFreezeDuration">0.5</span>s
        </p>
        <p id="timeFreezeStatus">Locked</p>
        <button id="timeFreezeBuyUpgrade" disabled>
          Unlock - 500 clicks
        </button>
        <button id="timeFreezeActivate" disabled>
          Activate Time Freeze [F]
        </button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>© <%= new Date().getFullYear() %> Clicker v.0.0.2</p>
  </footer>

  <script src="/js/index.js" defer></script>
  <script>
    window.isAuthenticated = <%= isAuthenticated ? 'true' : 'false' %>;
    window.initialProgress = <%- JSON.stringify(initialProgress) %>;
  </script>
</body>
</html>